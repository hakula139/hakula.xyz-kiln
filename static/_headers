# Override Workers Static Assets' default of `max-age=0, must-revalidate`
# per content-stability tier. Specific rules clear the catch-all with
# `! Cache-Control` because Cloudflare otherwise merges header values.

# ── Catch-all default (HTML and anything not overridden below) ──

/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# ── Content-addressed assets (`<stem>.<hash>.<ext>`) ──

/*.:hash.avif
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.bmp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.gif
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.ico
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.jpeg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.otf
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.ttf
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.woff
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.:hash.mjs
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/css/site.:hash.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/css/page.:hash.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*/assets/css/page.:hash.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# ── Non-production hosts: keep previews out of search results ──

https://dev.hakula.xyz/*
  X-Robots-Tag: noindex

https://:version.hakula.workers.dev/*
  X-Robots-Tag: noindex
