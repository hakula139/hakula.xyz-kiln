{
  "private": true,
  "scripts": {
    "build": "pnpm run --parallel \"/^build:css:/\"",
    "build:css:site": "tailwindcss -i static/css/_src/main.css -o static/css/style.css",
    "build:css:about-me": "tailwindcss -i static/css/_src/pages/about-me.css -o content/about-me/assets/style.css",
    "build:css:avg-impressions": "tailwindcss -i static/css/_src/pages/avg-impressions.css -o content/posts/avg/impressions/style.css",
    "dev": "pnpm run --parallel \"/^build:css:/\" --watch",
    "format": "prettier --check .",
    "lint": "pnpm lint:md && pnpm lint:js",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"content/**/*.md\"",
    "spellcheck": "cspell --no-progress \"content/**/*.md\""
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@cspell/dict-grc": "^1.0.7",
    "@cspell/dict-it-it": "^3.1.6",
    "@cspell/dict-la": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "cspell": "^10.3.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.140.0"
  }
}
