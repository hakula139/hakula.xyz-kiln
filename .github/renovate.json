{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hakulab/devkit#v3"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
